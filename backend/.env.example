# Database Configuration
DATABASE_URL="file:./dev.db"
# For Vercel Production deployment: Use Turso / LibSQL Network Database
TURSO_DATABASE_URL="libsql://your-database-name.turso.io"
TURSO_AUTH_TOKEN="your-turso-auth-token"

# Server Network Configuration
PORT=4000
HOST="127.0.0.1"
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
LOG_LEVEL="info"

# Escrow State Machine Settings
INSPECTION_WINDOW_SECONDS=48
MOCK_LATENCY_MIN_MS=200
MOCK_LATENCY_MAX_MS=500

# Authentication & Secret Keys (REPLACE IN PRODUCTION)
API_SECRET="your_secure_api_secret_key_here"
JWT_SECRET="your_secure_jwt_signing_secret_here"

# Webhook Cryptographic Verification Secrets
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret_here"
EASYPOST_WEBHOOK_SECRET="ep_whsec_your_easypost_webhook_secret_here"
